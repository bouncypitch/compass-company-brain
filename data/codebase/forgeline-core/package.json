{
  "name": "@forgeline/core",
  "version": "0.14.2",
  "private": true,
  "description": "Indexing, retrieval, and agent loop behind the Forgeline IDE extension and CLI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "forge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
