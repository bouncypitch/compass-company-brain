    "fast-glob": "^3.3.2",
    "ignore": "^5.3.1",
    "p-limit": "^3.1.0",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "eslint": "^9.7.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
